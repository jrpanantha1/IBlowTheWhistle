        }

        .dropdown-item {
            color: white;
        }
    </style>
    <script type="text/javascript">
        function checkandredirect() {
            if (localStorage.getItem("AcctType") != null) {
                window.location.href = "/Pages/ViewIncidents.aspx";
            }
            else {
                window.location.href = "/Pages/Default.aspx";
            }
        }
    </script>
